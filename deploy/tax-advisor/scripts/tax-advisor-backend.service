[Unit]
Description=Tax Advisor Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tax-advisor/backend
ExecStart=/usr/bin/java -jar /opt/tax-advisor/backend/taxprofessionals-0.0.1-SNAPSHOT.jar
EnvironmentFile=-/opt/tax-advisor/backend/.env
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
